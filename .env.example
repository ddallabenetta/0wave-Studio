# 0wave Studio environment variables.
# Copy to .env.local and fill in as needed. No real keys here.

# Persistence access mode. One of:
#   PUBLIC_LOCAL     (default) IndexedDB only, no backend, works offline.
#   ANONYMOUS_CLOUD  Supabase with anonymous sessions; optional email link.
#   ACCOUNT_REQUIRED Supabase with email magic-link sign-in; /studio and
#                    /playground redirect to /login until a session exists.
# Any other value (or nothing) falls back to PUBLIC_LOCAL.
NEXT_PUBLIC_ZEROWAVE_ACCESS_MODE=PUBLIC_LOCAL

# Supabase project credentials (anon/public role key only).
# Required for ANONYMOUS_CLOUD and ACCOUNT_REQUIRED; ignored in PUBLIC_LOCAL.
# Find these in the Supabase dashboard under Project Settings -> API.
# NEVER put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Sound Connector (text-to-patch, /api/ai/patch).
# Server-side ONLY: never use a NEXT_PUBLIC_ prefix for these. When
# OPENAI_API_KEY is unset the connector answers 503 "provider not configured".
OPENAI_API_KEY=
# Optional: OpenAI-compatible API base URL (default https://api.openai.com/v1).
OPENAI_BASE_URL=
# Optional: model id (default gpt-4o-mini).
OPENAI_MODEL=
# Optional: max completion tokens per request — cost cap (default 1024).
AI_MAX_TOKENS=
# Optional: per-minute request budget per client IP (default 10).
AI_RATE_LIMIT_PER_MINUTE=
